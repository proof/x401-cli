{
  "name": "@proof.com/x401-cli",
  "version": "0.1.0",
  "description": "x401-cli: fetch x401-protected URLs from a terminal, a coding agent or a cron job with the user's Proof credential.",
  "keywords": [
    "x401",
    "CLI",
    "Agent",
    "Verifiable Presentation",
    "Proof",
    "Proof.com"
  ],
  "homepage": "https://github.com/proof/x401-cli",
  "bugs": "https://github.com/proof/x401-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/proof/x401-cli.git"
  },
  "license": "Apache-2.0",
  "author": "Jeremie Charrier <jeremie.charrier@proof.com>",
  "type": "module",
  "bin": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-all": "yarn format && yarn lint && yarn typecheck && yarn test && yarn publint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepare": "npm run build",
    "publint": "publint --pack npm",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proof.com/proof-vc-common": "^0.7.0",
    "@proof.com/x401-agent": "^0.1.0",
    "@proof.com/x401-node": "^0.3.3",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
